# Copy to .env (never commit .env) and replace every <...> placeholder.

# PostgreSQL (Docker)
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=<postgres-database>
POSTGRES_PORT=5432

# Local S3-compatible object storage (SeaweedFS), stand-in for Cloudflare R2
OBJECT_STORAGE_ACCESS_KEY=<access-key>
OBJECT_STORAGE_SECRET_KEY=<secret-key>
OBJECT_STORAGE_PORT=8333

# Backend (Go API). Expanded by the shell/Docker Compose from the values above.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:${OBJECT_STORAGE_PORT}
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=catalog-images
# Development only: create the bucket on start. Leave false against Cloudflare R2.
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true

# Everything in containers (`make app-up`, see docker/docker-compose.yml). Compose sets the container-side addresses itself.
# Port and address where nginx (web + /api) is published. 127.0.0.1 keeps it private to this machine;
# use 0.0.0.0 to open it to the local network (there is no authentication yet).
WEB_PORT=8081
WEB_BIND=127.0.0.1
# Optional. Where browsers open signed image URLs. Defaults to http://localhost:${OBJECT_STORAGE_PORT}.
# OBJECT_STORAGE_PUBLIC_ENDPOINT=http://<address-reachable-from-the-browser>:8333
# Optional. Public address printed in the QR labels (build time, public: never a secret). Empty uses the
# address the app is opened from.
# VITE_PUBLIC_BASE_URL=http://<address-or-domain>:8081
# Server with Traefik (`make app-up-traefik`): public hosts, with DNS records pointing to the server.
# Then also set OBJECT_STORAGE_PUBLIC_ENDPOINT=https://<storage host> and VITE_PUBLIC_BASE_URL=https://<app host>.
# GUMUNOVA_HOST=gumunova.<your-domain>
# GUMUNOVA_STORAGE_HOST=storage-gumunova.<your-domain>
# Passwords with special characters must be URL-encoded in the DATABASE_URL that compose builds.
